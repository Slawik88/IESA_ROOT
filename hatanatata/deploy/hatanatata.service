[Unit]
Description=HataNatata private Swiss rental alerts
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=hatanatata
Group=hatanatata
WorkingDirectory=/opt/hatanatata/releases/RELEASE_SHA
EnvironmentFile=/etc/iesa/hatanatata.env
Environment=PYTHONUNBUFFERED=1
Environment=MALLOC_ARENA_MAX=2
ExecStart=/opt/hatanatata/venvs/RELEASE_SHA/bin/python -m hatanatata
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
UMask=0077
StateDirectory=hatanatata
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hatanatata
MemoryHigh=128M
MemoryMax=220M
CPUQuota=15%
Nice=10
IOWeight=10
TasksMax=24
LimitNOFILE=512
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
