# .env.example — copy to .env and fill in real values
# DO NOT commit .env to version control

# ── Django core ──────────────────────────────────────────────────────────────
SECRET_KEY_DJANGO='your-secret-key-here'
DEBUG=False
SECURE_SSL_REDIRECT=True
SITE_DOMAIN=iesasport.ch
ALLOWED_HOSTS=iesasport.ch,www.iesasport.ch

# ── Database ──────────────────────────────────────────────────────────────────
# Heroku/Render Postgres (overrides default SQLite)
DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_POOL_URL=
DB_CONN_MAX_AGE=60

# ── Telegram Bot ──────────────────────────────────────────────────────────────
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=IESA_Administrator_bot
TELEGRAM_WEBHOOK_SECRET=

# ── DigitalOcean Spaces (S3-compatible storage) ───────────────────────────────
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=iesa-bucket
SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com

# ── Stripe payments ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=

# ── Resend (transactional email) ───────────────────────────────────────────────
RESEND_API_KEY=

# ── CleverReach (newsletter) ───────────────────────────────────────────────────
CLEVERREACH_CLIENT_ID=
CLEVERREACH_CLIENT_SECRET=
CLEVERREACH_ACCESS_TOKEN=
CLEVERREACH_REFRESH_TOKEN=
CLEVERREACH_SENDER_EMAIL=noreply@iesasport.ch
CLEVERREACH_SENDER_NAME=IESA Sport

# ── Dev / test data scripts ────────────────────────────────────────────────────
# Password for superuser created by populate_massive_data.py
SUPERUSER_PASSWORD=changeme
