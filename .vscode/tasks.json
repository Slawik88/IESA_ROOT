{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Predvestnik: local preview",
      "type": "shell",
      "command": "nix-shell",
      "args": [
        "-p",
        "nodejs_22",
        "--run",
        "npm run preview --prefix predvestnik_v2"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "predvestnik-preview",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "preview on http://localhost:8402/"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
