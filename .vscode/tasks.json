{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Predvestnik preprod: PostgreSQL start",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "RemoteSigned",
        "-File",
        "${workspaceFolder}\\predvestnik_v2\\tools\\preprod_postgres.ps1",
        "start"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Predvestnik preprod: Cloudflare tunnel",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "RemoteSigned",
        "-File",
        "${workspaceFolder}\\predvestnik_v2\\tools\\run_preprod_tunnel.ps1"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Predvestnik preprod: Bot + API",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "RemoteSigned",
        "-File",
        "${workspaceFolder}\\predvestnik_v2\\tools\\run_preprod.ps1"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Predvestnik preprod: compact smoke",
      "type": "shell",
      "command": "python",
      "args": [
        "${workspaceFolder}\\predvestnik_v2\\tools\\verify_preprod_smoke.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\predvestnik_v2"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
