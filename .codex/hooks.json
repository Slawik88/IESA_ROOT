{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "G:/IESA_ROOT/.venv/Scripts/graphify.EXE hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "G:/IESA_ROOT/.venv/Scripts/graphify.EXE hook-guard read"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
