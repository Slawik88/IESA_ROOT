# Токен бота из BotFather (обязательно)
DOMOVOY_BOT_TOKEN=

# База данных: по умолчанию sqlite в data/domovoy.db (разработка).
# Для прода на сервере — строка PostgreSQL: postgresql://user:pass@host:5432/domovoy
# DOMOVOY_DATABASE_URL=

# Telegram id разработчика(ов) со скрытым супер-доступом, через запятую
DOMOVOY_SUPERADMIN_TG_IDS=

# Уровень логов (по умолчанию INFO)
# DOMOVOY_LOG_LEVEL=INFO
